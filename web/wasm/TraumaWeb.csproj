<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- RVIP web build: .NET 10 browser-wasm (Mono interpreter), runs inside a module Web Worker.
       Compiles the TraumaRL game (RogueBasin core + GraphMap + TraumaRL) with managed shims for
       libtcod-net, SdlDotNet and System.Windows.Forms (web/shim). The compile list mirrors the
       VS2013 csprojs (they list files explicitly; some .cs files on disk are not built). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>TraumaWeb</AssemblyName>
    <RootNamespace>RogueBasin</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);WEB</DefineConstants>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS0618;CS0108;CS0114;NU1701;CS8981;SYSLIB0011;SYSLIB0050;SYSLIB0051;CA1416;CS0659;CS0661;CS0660;CS1998;CS0067;CA2200</NoWarn>
    <StartupObject>RogueBasin.WebMain</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- trim the framework only (partial): the game and QuikGraph are kept whole (reflection saves).
         QuikGraph (netstandard fork) replaces QuickGraph 3.6 net4, whose iterators crash ILLink 10 (IL1012). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <WasmEnableThreads>false</WasmEnableThreads>
    <CompressionEnabled>false</CompressionEnabled>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <Import Project="../sources.props" />
  <!-- BinaryFormatter loads these facades by name (type names in saves) -->
  <ItemGroup><TrimmerRootAssembly Include="mscorlib" /><TrimmerRootAssembly Include="System" /><TrimmerRootAssembly Include="System.Core" /><TrimmerRootAssembly Include="System.Collections" /></ItemGroup>
  <ItemGroup>
    <Compile Include="WebBackend.cs" />
    <EmbeddedResource Include="../config.txt" LogicalName="data/config.txt" />
  </ItemGroup>
  <!-- BinaryFormatter (saves): the runtime pack's System.Runtime.Serialization.Formatters is a stub that throws
       BinaryFormatter_Removed and wins the conflict with the NuGet package's real one; drop the stub. -->
  <PropertyGroup><RvipFormattersDll>$(NuGetPackageRoot)system.runtime.serialization.formatters/10.0.0/lib/net8.0/System.Runtime.Serialization.Formatters.dll</RvipFormattersDll></PropertyGroup>
  <Target Name="RvipFormattersFromPackage" AfterTargets="_HandlePackageFileConflicts;ResolveRuntimePackAssets" BeforeTargets="_ResolveCopyLocalAssetsForPublish">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(Filename)' == 'System.Runtime.Serialization.Formatters'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'System.Runtime.Serialization.Formatters.dll'" />
      <ReferenceCopyLocalPaths Include="$(RvipFormattersDll)" DestinationSubDirectory="" />
    </ItemGroup>
  </Target>
</Project>
